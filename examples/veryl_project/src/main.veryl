module Wire(
    medium_input: input logic<32>,
    medium_output: output logic<32>
) {
    assign medium_output = medium_input;
}

module U8Counter(
    i_clk: input clock,
    i_reset: input logic,
    enable: input logic,
    value: output logic<8>
) {
    always_ff {
        if i_reset {
            value = 0;
        } else {
            value = if enable ? (value + 1) : value;
        }
    }
}
